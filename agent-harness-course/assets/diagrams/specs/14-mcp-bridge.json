  "cards": [
    {
      "dot": "cyan",
      "title": "MCP 是什么【公开资料】",
      "items": [
        "Model Context Protocol：JSON-RPC 2.0 上的工具生态协议",
        "Host 内嵌 Client，Server 以 stdio 子进程或 Streamable HTTP 暴露能力",
        "三种原语：tools（可调用）/ resources（可读）/ prompts（模板）"
      ]
    },
    {
      "dot": "rose",
      "title": "Pi 的接法【源码】",
      "items": [
        "src/extensions/index.ts：mcp 是 builtin + replaceable 的内置扩展",
        "默认 exposure: codemode —— 工具不声明给模型，脚本用 searchTools() 找",
        "客户端独立成包 packages/mcp，第三方扩展可整个顶替内置实现"
      ]
    },
    {
      "dot": "emerald",
      "title": "归属层级与上下文预算",
      "items": [
        "四档归属：Core 工具 / 内置扩展 / 用户扩展与包 / 外部进程",
        "接入 ≠ 声明：接了协议也可以一条工具描述都不加",
        "判断顺序：生态密度 → 信任模型 → 上下文预算 → 归属层级"
      ]
    }
  ]
