  "cards": [
    {
      "dot": "cyan",
      "title": "为什么不全量注入",
      "items": [
        "20 个 skill 全文可能 5 万 token——大部分轮次用不到",
        "目录只有每条一两行，常驻成本趋近于零"
      ]
    },
    {
      "dot": "rose",
      "title": "与 Traditional 的差别",
      "items": [
        "Traditional：System Prompt 塞满全部文档 → 贵、 cache 失效快",
        "Progressive：小注册表常驻 → 全文只在触发后进入 Context"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pi 的取舍",
      "items": [
        "disable-model-invocation 的 skill 不进目录，仅 /skill:name 调用",
        "同名冲突记入 collision 诊断，不静默覆盖"
      ]
    }
  ]
