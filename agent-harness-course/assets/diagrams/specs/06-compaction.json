    {
      "dot": "cyan",
      "title": "为什么不能直接删最老的消息",
      "items": [
        "中间摘要丢失会导致目标漂移与重复劳动",
        "toolCall/toolResult 必须成对保留，否则请求被 API 拒绝"
      ]
    },
    {
      "dot": "rose",
      "title": "Compaction = State Compression",
      "items": [
        "历史永远完整保存在 Session（JSONL 不动）",
        "压缩只改变「投影」——模型可见的那一份"
      ]
    },
    {
      "dot": "emerald",
      "title": "三层连接",
      "items": [
        "Session：持久状态（全量）",
        "Compaction：把旧状态压成摘要条目"
      ]
    }
  ],
