  "cards": [
    {
      "dot": "cyan",
      "title": "为什么是树而不是 messages[]",
      "items": [
        "append-only 让「改写历史」在物理上不可能",
        "分支 = 移动 leafId 指针，零拷贝、可回退"
      ]
    },
    {
      "dot": "rose",
      "title": "Entry 类型不止消息",
      "items": [
        "model_change / thinking_level_change 记录配置演变",
        "compaction / branch_summary 是特殊的摘要条目"
      ]
    },
    {
      "dot": "emerald",
      "title": "Session ≠ Context",
      "items": [
        "历史树完整保存在磁盘",
        "投影（projection）决定哪些条目进入本轮 Context"
      ]
    }
  ]
