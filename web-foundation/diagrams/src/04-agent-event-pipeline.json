  "cards": [
    {
      "dot": "emerald",
      "title": "解耦边界",
      "items": [
        "Agent 只管 yield 事件，不知道 SSE/WS 的存在",
        "换协议、写测试、换供应商都只动通信层",
        "统一信封：seq / type / task_id / timestamp / data"
      ]
    },
    {
      "dot": "cyan",
      "title": "不漏不重",
      "items": [
        "先订阅队列，再补发缓冲历史",
        "水位线 seq 去重重叠区",
        "终态事件后关闭流"
      ]
    },
    {
      "dot": "orange",
      "title": "双通道分工",
      "items": [
        "SSE 向右：单向直播，断线可续传",
        "WS 向左：控制指令送回 Agent 检查点",
        "单进程 Hub 是 Redis Pub/Sub 的预演"
      ]
    }
  ]
}