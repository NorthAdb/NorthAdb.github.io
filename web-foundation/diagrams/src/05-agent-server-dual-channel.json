  "cards": [
    {
      "dot": "cyan",
      "title": "双通道各司其职",
      "items": [
        "SSE（实线）：Agent → UI 的单向事件直播",
        "WS（虚线/安全线）：UI → Agent 的控制指令 + 状态镜像",
        "REST：创建与查询，任务的唯一入口"
      ]
    },
    {
      "dot": "emerald",
      "title": "审批的本质",
      "items": [
        "agent 在 wait_approval() 挂起在一个 Future 上",
        "WS 收到 approve/reject 后 set_result() 唤醒它",
        "human-in-the-loop = 把一次 await 的答案交给人类"
      ]
    },
    {
      "dot": "orange",
      "title": "通往生产（v8）",
      "items": [
        "WS 镜像目前是单进程 ControlHub 广播",
        "多 Worker 后改由 Redis Pub/Sub 承担",
        "事件缓冲改 Redis Stream，支持跨进程续传"
      ]
    }
  ]
}